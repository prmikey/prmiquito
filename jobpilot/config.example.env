# Copy to .env and adjust.

# Any OpenAI-compatible endpoint works. Default: Ollama running locally
# (e.g. `ollama pull hermes3 && ollama serve` on the same VM).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=hermes3

# Where the SQLite database lives (docker-compose mounts ./data).
JOBPILOT_DB=data/jobpilot.db

# How often the discovery pipeline runs, in hours.
CRAWL_INTERVAL_HOURS=4

PORT=8300
